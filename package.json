{
  "name": "ai-basics-exam-trainer",
  "version": "1.0.0",
  "private": true,
  "description": "Независимый русскоязычный тренажёр по программе экзамена «Основы работы с ИИ»: 180 вопросов, 6 доменов, 3 уровня.",
  "license": "MIT",
  "author": "Ed Would (https://github.com/ed-would)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ed-would/yandex-ai-studio-exam-lab.git"
  },
  "homepage": "https://github.com/ed-would/yandex-ai-studio-exam-lab#readme",
  "bugs": {
    "url": "https://github.com/ed-would/yandex-ai-studio-exam-lab/issues"
  },
  "keywords": [
    "yandex-ai-studio",
    "ai-literacy",
    "generative-ai",
    "exam-preparation",
    "quiz",
    "russian",
    "preact",
    "vite"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:results": "vite --port 4178 --strictPort --mode results-preview",
    "build": "npm run validate && vite build",
    "preview": "vite preview",
    "lint": "npm run lint:js && npm run lint:css && npm run format:check",
    "lint:js": "oxlint --deny-warnings .",
    "lint:css": "stylelint \"{src,public}/**/*.css\" --max-warnings 0",
    "lint:fix": "oxlint --fix . && npm run lint:css -- --fix && npm run format",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "hooks:install": "node scripts/install-hooks.mjs",
    "postinstall": "npm run hooks:install",
    "validate": "node scripts/validate-bank.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run lint && npm run validate && npm test && vite build",
    "ci:dispatch": "gh workflow run ci.yml --ref main",
    "pages:dispatch": "gh workflow run pages.yml --ref main"
  },
  "dependencies": {
    "htm": "3.1.1",
    "preact": "11.0.1"
  },
  "devDependencies": {
    "braces": "file:vendor/braces/braces-3.0.3-patch.2.tgz",
    "happy-dom": "20.14.6",
    "lefthook": "2.1.10",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "stylelint": "17.16.0",
    "stylelint-config-recommended": "18.0.0",
    "vite": "8.3.4"
  },
  "overrides": {
    "braces": "$braces"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "lefthook@2.1.10": true
  }
}
